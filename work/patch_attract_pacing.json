{
  "dlg02#0015": "In the heavens lies",
  "dlg02#0016": "the Algol solar system...",
  "dlg02#0017": "Long ago,\nupon its worlds,",
  "dlg02#0018": "a brilliant civilization flourished.",
  "dlg02#0019": "Its people surrendered themselves",
  "dlg02#0020": "to prosperity and pleasure.",
  "dlg02#0021": "But then,",
  "dlg02#0022": "the planetary management system",
  "dlg02#0023": "known as Mother Brain",
  "dlg02#0024": "was destroyed, plunging all into chaos.",
  "dlg02#0025": "The first planet, Palma,",
  "dlg02#0026": "exploded and vanished.",
  "dlg02#0027": "More than ninety percent",
  "dlg02#0028": "of the total population perished.",
  "dlg02#0029": "The old scientific civilization was lost,",
  "dlg02#0030": "and the people's lives",
  "dlg02#0031": "fell into poverty and hardship.",
  "dlg02#0032": "And then, a thousand years passed...",
  "dlg02#0033": "As the years went by,",
  "dlg02#0034": "the people found new strength to live.",
  "dlg02#0035": "Once again, the bud of prosperity",
  "dlg02#0036": "sought to take root in Algol,",
  "dlg02#0037": "but the unforgiving environment",
  "dlg02#0038": "would not easily allow it..."
}
